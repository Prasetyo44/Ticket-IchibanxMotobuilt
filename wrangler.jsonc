{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ichiban-tiket",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  // Hanya bisa dibuka lewat custom domain (alamat workers.dev dimatikan supaya tidak ada pintu kedua)
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/f/*", "/t/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ichiban-tiket",
      "database_id": "c355c1d5-79f6-41e9-a775-0603c44ada1f",
      "migrations_dir": "migrations"
    }
  ]
}
