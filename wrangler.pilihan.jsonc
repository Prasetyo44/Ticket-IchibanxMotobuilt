{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ichiban-pilihan",
  "main": "src/pilihan.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "keep_vars": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public-pilihan",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin", "/admin/*", "/admin.html"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ichiban-pilihan",
      "database_id": "ISI-DENGAN-ID-DATABASE-D1-PILIHAN"
    }
  ]
}
