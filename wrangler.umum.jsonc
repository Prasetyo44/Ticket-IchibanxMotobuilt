{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ichiban-tiket-umum",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "keep_vars": true,
  "preview_urls": false,
  "vars": { "MODE": "umum" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/f/*", "/t/*", "/admin", "/admin/*", "/admin.html", "/", "/index.html", "/robots.txt"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ichiban-tiket-umum",
      "database_id": "818c4e1d-1099-4694-b0ec-73c165d41023",
      "migrations_dir": "migrations"
    }
  ]
}
